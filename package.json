{
  "name": "pranavdhawan-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:html": "html-validate index.html privacy.html blog/*.html",
    "test:function": "node --test tests/ask-function.node.mjs tests/csp-report.node.mjs tests/knowledge-sync.node.mjs tests/ci-workflow.node.mjs tests/type-scale.node.mjs tests/blog-posts.node.mjs",
    "build": "node scripts/build-site.mjs",
    "dev": "node scripts/build-site.mjs && node scripts/serve.mjs",
    "check:headers": "node tests/check-netlify-headers.mjs",
    "check": "npm run build && npm run test:html && npm run check:headers && npm run test:function && npm test"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.54.2",
    "esbuild": "^0.28.1",
    "html-validate": "^9.5.3",
    "lightningcss": "^1.33.0",
    "sharp": "^0.35.3"
  }
}
